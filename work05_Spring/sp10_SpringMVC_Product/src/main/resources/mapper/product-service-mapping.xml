<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ns.sql.MyProductMapper">	

	<sql id="select-myproduct">
		SELECT id, name, maker, price
		FROM myproduct 
	</sql>
	<!-- 상품 추가 -->
	<!-- INSERT문 작성 시 PK에 해당하는 컬럼값이 DB에서 자동 증가하는 값일 때는 주의해야 한다.
		1) 먼저 DB에서 PK 값을 증가시킨다. 
		2) 증가 된 그 값을 vo에 (pvo) setter로 주입. 
		3) 결과적으로 pvo와 DB 테이블 (rvo)를 완벽하게 동기화 시킨다. 
	 -->
	 
	 
	<insert id="addProduct" parameterType="myProduct" >
		<selectKey keyProperty="id" order="BEFORE" resultType="int" >
			SELECT myproduct_seq.nextVal FROM dual			
		</selectKey>
		
		INSERT 
		INTO myproduct(id,name,maker,price)
		VALUES(#{id}, #{name},#{maker},#{price})
	</insert>
	
	<select id="findProduct" parameterType="myProduct" resultType="myProduct">
		<include refid="select-myproduct" />
		<where>
			<if test="value !=null">
				 name like '%' || #{VALUE} ||'%'
			</if>
			<if test="value !=null">
				OR maker = #{maker}
			</if>
		</where>	
	</select>
	
